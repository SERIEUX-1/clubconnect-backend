DJANGO_SECRET_KEY=change-me-generate-a-real-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://clubconnect:clubconnect@localhost:5432/clubconnect
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
TIME_ZONE=Indian/Mauritius
PUBLIC_APP_URL=http://127.0.0.1:5173

# AI stays optional and unused unless you set a key. Homegrown Copilot does not need this.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Evidence: leave bucket empty for local disk. Set these for S3 / Spaces / MinIO.
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_DIR=

# Mail concerned people at their ClubConnect account email.
# Local: docker compose up mailhog, then open http://127.0.0.1:8025
# Campus SMTP: set EMAIL_HOST to the institution relay. Do not invent addresses.
NOTIFICATION_CHANNELS=in_app,email
DEFAULT_FROM_EMAIL=ClubConnect <noreply@clubconnect.local>
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_FILE_PATH=

# SSO buttons stay off until the campus gives a real client ID.
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=

# Production HTTPS (leave off until the public URL is TLS-terminated)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
