DJANGO_SECRET_KEY=change-me-generate-a-real-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://clubconnect:clubconnect@localhost:5432/clubconnect
CORS_ALLOWED_ORIGINS=http://localhost:5173
